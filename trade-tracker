<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Biverway — Trade Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#08090e;--surf:#0d0f18;--surf2:#111420;--line:#1e2236;--line2:#262d44;
  --gold:#c9973a;--gold-hi:#e8b84b;--gold-lo:#7a5c1e;
  --green:#2db882;--red:#e05050;--amber:#d4821a;--blue:#4a8fd4;
  --dim:#4a5878;--dim2:#1a2035;--text:#d0daf0;--text2:#7888aa;--text3:#a0b0cc;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;}
.top-rule{height:1px;background:linear-gradient(90deg,transparent 0%,var(--gold-lo) 20%,var(--gold) 50%,var(--gold-lo) 80%,transparent 100%);}
.wrap{max-width:760px;margin:0 auto;padding:0 18px;}

/* ── AUTH ── */
#auth-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px;}
.auth-box{background:var(--surf);border:1px solid var(--line);border-radius:14px;padding:32px 28px;width:100%;max-width:360px;}
.auth-logo{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:0.22em;color:var(--gold);text-transform:uppercase;margin-bottom:4px;}
.auth-title{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:0.06em;color:#fff;margin-bottom:24px;}
.auth-field{margin-bottom:14px;}
.auth-field label{display:block;font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:var(--dim);margin-bottom:5px;}
.auth-field input{width:100%;background:var(--bg);border:1px solid var(--line2);border-radius:8px;color:var(--text);font-family:'Space Mono',monospace;font-size:12px;padding:10px 12px;outline:none;}
.auth-field input:focus{border-color:var(--gold-lo);}
.auth-btn{width:100%;padding:11px;background:rgba(201,151,58,0.12);border:1px solid rgba(201,151,58,0.3);border-radius:8px;color:var(--gold);font-family:'Space Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;transition:all 0.2s;margin-top:6px;}
.auth-btn:hover{background:rgba(201,151,58,0.2);}
.auth-err{font-family:'Space Mono',monospace;font-size:8px;color:var(--red);margin-top:10px;display:none;}

/* ── HEADER ── */
#app-screen{display:none;}
header{padding:20px 0 16px;border-bottom:1px solid var(--line);}
.hdr{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.brand-eye{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:0.2em;color:var(--gold);text-transform:uppercase;margin-bottom:4px;}
.brand-name{font-family:'Bebas Neue',sans-serif;font-size:clamp(22px,5vw,32px);letter-spacing:0.05em;line-height:1;color:#fff;}
.brand-name span{color:var(--gold);}
.hdr-right{display:flex;gap:8px;align-items:center;}
.back-btn{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:6px 12px;border-radius:6px;border:1px solid var(--line2);background:transparent;color:var(--dim);cursor:pointer;text-decoration:none;transition:all 0.2s;}
.back-btn:hover{color:var(--text2);border-color:var(--dim);}
.signout-btn{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:6px 12px;border-radius:6px;border:1px solid var(--line2);background:transparent;color:var(--dim);cursor:pointer;transition:all 0.2s;}
.signout-btn:hover{color:var(--red);border-color:rgba(224,80,80,0.4);}

/* ── NAV ── */
.nav{display:flex;border-bottom:1px solid var(--line);background:var(--surf2);margin-bottom:0;}
.nav-tab{flex:1;padding:10px 0;text-align:center;font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--dim);cursor:pointer;border:none;background:transparent;border-right:1px solid var(--line);transition:all 0.18s;position:relative;}
.nav-tab:last-child{border-right:none;}
.nav-tab::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:var(--gold);transform:scaleX(0);transition:transform 0.2s;}
.nav-tab.active{color:var(--gold);}
.nav-tab.active::after{transform:scaleX(1);}

/* ── PANELS ── */
.panel{display:none;padding:16px 0 60px;}
.panel.active{display:block;}

/* ── SECTION HEADER ── */
.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px;}
.sec-title{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:0.08em;color:var(--text3);}

/* ── FILTER BAR ── */
.filter-bar{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.fsel{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.06em;padding:6px 10px;border-radius:6px;border:1px solid var(--line2);background:var(--bg);color:var(--text2);cursor:pointer;outline:none;}
.fsel option{background:var(--surf);}

/* ── TRADE CARDS ── */
.trade-list{display:flex;flex-direction:column;gap:6px;}
.trade-card{background:var(--surf);border:1px solid var(--line);border-radius:10px;overflow:hidden;cursor:pointer;transition:border-color 0.2s;}
.trade-card:hover{border-color:var(--line2);}
.trade-card.win{border-left:3px solid rgba(45,184,130,0.5);}
.trade-card.loss{border-left:3px solid rgba(224,80,80,0.5);}
.trade-card.pending{border-left:3px solid rgba(201,151,58,0.5);}
.trade-card.triggered{border-left:3px solid rgba(212,130,26,0.5);}
.trade-card.discarded{border-left:3px solid rgba(74,88,120,0.4);opacity:0.6;}
.tc-top{display:flex;align-items:center;gap:10px;padding:10px 14px;}
.tc-inst{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:0.06em;color:var(--text3);min-width:32px;}
.tc-date{font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);flex:1;}
.tc-grade{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.08em;padding:2px 8px;border-radius:3px;}
.tc-grade.prime{background:rgba(201,151,58,0.1);color:var(--gold);border:1px solid rgba(201,151,58,0.2);}
.tc-grade.take{background:rgba(45,184,130,0.08);color:var(--green);border:1px solid rgba(45,184,130,0.2);}
.tc-grade.skip{background:rgba(224,80,80,0.08);color:var(--red);border:1px solid rgba(224,80,80,0.2);}
.tc-outcome{font-family:'Space Mono',monospace;font-size:9px;font-weight:700;min-width:36px;text-align:right;}
.tc-outcome.w{color:var(--green);}
.tc-outcome.l{color:var(--red);}
.tc-outcome.p{color:var(--gold);}
.tc-outcome.t{color:var(--amber);}
.tc-outcome.d{color:var(--dim);}
.tc-flags{padding:0 14px 10px;display:flex;gap:5px;flex-wrap:wrap;}
.tc-flag{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:0.06em;padding:1px 6px;border-radius:3px;background:rgba(212,130,26,0.08);color:var(--amber);border:1px solid rgba(212,130,26,0.15);}
.empty-state{font-family:'Space Mono',monospace;font-size:9px;color:var(--dim);text-align:center;padding:40px 0;letter-spacing:0.08em;}

/* ── DETAIL MODAL ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:300;display:none;align-items:flex-start;justify-content:center;overflow-y:auto;padding:20px;}
.modal-overlay.open{display:flex;}
.modal{background:var(--surf);border:1px solid var(--line);border-radius:14px;width:100%;max-width:680px;margin:auto;overflow:hidden;}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--surf2);}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:0.08em;color:var(--text3);}
.modal-close{font-family:'Space Mono',monospace;font-size:16px;color:var(--dim);background:none;border:none;cursor:pointer;padding:2px 6px;}
.modal-close:hover{color:var(--text);}
.modal-body{padding:18px;}
.modal-section{margin-bottom:18px;padding-bottom:18px;border-bottom:1px solid var(--line);}
.modal-section:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0;}
.modal-sec-title{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:var(--dim);margin-bottom:10px;}
.detail-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;}
.detail-item{background:var(--bg);border:1px solid var(--line);border-radius:7px;padding:8px 10px;}
.detail-item.full{grid-column:1/-1;}
.di-label{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:0.1em;color:var(--dim);text-transform:uppercase;margin-bottom:3px;}
.di-val{font-family:'Space Mono',monospace;font-size:9px;color:var(--text2);line-height:1.5;}
.img-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.img-slot{background:var(--bg);border:1px solid var(--line);border-radius:8px;aspect-ratio:16/9;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center;}
.img-slot img{width:100%;height:100%;object-fit:cover;}
.img-slot-label{position:absolute;bottom:6px;left:8px;font-family:'Space Mono',monospace;font-size:7px;letter-spacing:0.1em;color:#fff;background:rgba(0,0,0,0.6);padding:2px 6px;border-radius:3px;}
.img-placeholder{font-family:'Space Mono',monospace;font-size:7px;color:var(--dim);letter-spacing:0.08em;}
.action-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}
.act-btn{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:8px 14px;border-radius:7px;border:1px solid var(--line2);background:var(--bg);color:var(--dim);cursor:pointer;transition:all 0.2s;}
.act-btn:hover{color:var(--text2);border-color:var(--dim);}
.act-btn.primary{background:rgba(45,184,130,0.08);border-color:rgba(45,184,130,0.3);color:var(--green);}
.act-btn.danger{background:rgba(224,80,80,0.06);border-color:rgba(224,80,80,0.25);color:#c06060;}
.act-btn.gold{background:rgba(201,151,58,0.08);border-color:rgba(201,151,58,0.25);color:var(--gold);}
textarea.modal-notes{width:100%;background:var(--bg);border:1px solid var(--line2);border-radius:7px;color:var(--text2);font-family:'Space Mono',monospace;font-size:9px;padding:10px 12px;outline:none;resize:vertical;min-height:72px;margin-top:6px;}

/* ── UPLOAD ZONE ── */
.upload-zone{border:1px dashed var(--line2);border-radius:8px;padding:16px;text-align:center;cursor:pointer;transition:all 0.2s;background:var(--bg);}
.upload-zone:hover,.upload-zone.drag{border-color:var(--gold-lo);background:rgba(201,151,58,0.03);}
.upload-zone input{display:none;}
.upload-zone-txt{font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);letter-spacing:0.08em;}
.upload-preview{width:100%;border-radius:6px;margin-top:8px;max-height:160px;object-fit:cover;display:none;}

/* ── ANALYTICS ── */
.analytics-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:16px;}
.stat-card{background:var(--surf2);border:1px solid var(--line);border-radius:9px;padding:12px 14px;}
.stat-card.full{grid-column:1/-1;}
.stat-eye{font-family:'Space Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--dim);margin-bottom:4px;}
.stat-val{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:0.05em;line-height:1;}
.stat-sub{font-family:'Space Mono',monospace;font-size:7px;color:var(--dim);margin-top:2px;}
.breakdown-table{width:100%;border-collapse:collapse;font-family:'Space Mono',monospace;font-size:8px;}
.breakdown-table th{color:var(--dim);letter-spacing:0.1em;text-transform:uppercase;padding:6px 10px;border-bottom:1px solid var(--line);text-align:left;}
.breakdown-table td{color:var(--text2);padding:7px 10px;border-bottom:1px solid var(--line);}
.breakdown-table tr:last-child td{border-bottom:none;}
.breakdown-table .val-pos{color:var(--green);}
.breakdown-table .val-neg{color:var(--red);}
.breakdown-table .val-neu{color:var(--text3);}
.breakdown-table .val-gld{color:var(--gold);}
.an-sec{margin-bottom:20px;}
.an-sec-title{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:var(--gold-lo);margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line);}
.alert-card{background:rgba(212,130,26,0.04);border:1px solid rgba(212,130,26,0.2);border-radius:8px;padding:11px 13px;margin-bottom:6px;}
.alert-title{font-family:'Space Mono',monospace;font-size:8px;color:var(--amber);font-weight:700;letter-spacing:0.04em;margin-bottom:4px;}
.alert-body{font-family:'Space Mono',monospace;font-size:8px;color:var(--text2);line-height:1.6;}
.sample-note{font-family:'Space Mono',monospace;font-size:7px;color:var(--dim);margin-top:3px;}

/* ── EXPORT ── */
.export-section{background:var(--surf2);border:1px solid var(--line);border-radius:10px;padding:18px;}
.export-desc{font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);line-height:1.7;letter-spacing:0.04em;margin-bottom:16px;}
.export-btn{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:0.12em;text-transform:uppercase;padding:10px 20px;border-radius:8px;border:1px solid rgba(45,184,130,0.3);background:rgba(45,184,130,0.07);color:var(--green);cursor:pointer;transition:all 0.2s;}
.export-btn:hover{background:rgba(45,184,130,0.12);}

/* ── SAVE PROMPT (in decision engine) ── */
.save-prompt{display:none;margin-top:10px;padding:14px 16px;background:rgba(201,151,58,0.04);border:1px solid rgba(201,151,58,0.2);border-radius:10px;}
.save-prompt.show{display:block;}
.sp-title{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-lo);margin-bottom:10px;}
.sp-row{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;}
.sp-inst{display:flex;gap:5px;flex-wrap:wrap;flex:1;}
.sp-inst-btn{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.08em;padding:6px 12px;border-radius:6px;border:1px solid var(--line2);background:var(--bg);color:var(--dim);cursor:pointer;transition:all 0.2s;}
.sp-inst-btn.sel{background:rgba(201,151,58,0.1);border-color:rgba(201,151,58,0.4);color:var(--gold);}
.sp-upload{flex:1;min-width:160px;}
.sp-save{font-family:'Space Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:8px 16px;border-radius:7px;border:1px solid rgba(201,151,58,0.3);background:rgba(201,151,58,0.08);color:var(--gold);cursor:pointer;transition:all 0.2s;margin-top:8px;width:100%;}
.sp-save:hover{background:rgba(201,151,58,0.15);}
.sp-saved{font-family:'Space Mono',monospace;font-size:8px;color:var(--green);margin-top:6px;display:none;}

.loading{font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);text-align:center;padding:30px;letter-spacing:0.1em;}

@media(max-width:480px){
  .detail-grid{grid-template-columns:1fr;}
  .img-pair{grid-template-columns:1fr;}
  .analytics-grid{grid-template-columns:1fr;}
  .filter-bar{gap:4px;}
  .fsel{font-size:7px;padding:5px 8px;}
}
</style>
</head>
<body>
<div class="top-rule"></div>

<!-- ── AUTH SCREEN ── -->
<div id="auth-screen">
  <div class="auth-box">
    <div class="auth-logo">Biverway Trading System</div>
    <div class="auth-title">Trade Tracker</div>
    <div class="auth-field">
      <label>Email</label>
      <input type="email" id="auth-email" placeholder="your@email.com" autocomplete="email">
    </div>
    <div class="auth-field">
      <label>Password</label>
      <input type="password" id="auth-pass" placeholder="••••••••" autocomplete="current-password">
    </div>
    <button class="auth-btn" onclick="doSignIn()">Sign In</button>
    <div class="auth-err" id="auth-err"></div>
  </div>
</div>

<!-- ── APP SCREEN ── -->
<div id="app-screen">
  <div class="top-rule"></div>
  <div class="wrap">
    <header>
      <div class="hdr">
        <div>
          <div class="brand-eye">Biverway · Trade Tracker</div>
          <div class="brand-name">Model <span>A</span></div>
        </div>
        <div class="hdr-right">
          <a href="biverway-model-a.html" class="back-btn">← Decision Engine</a>
          <button class="signout-btn" onclick="doSignOut()">Sign Out</button>
        </div>
      </div>
    </header>

    <nav class="nav">
      <button class="nav-tab active" onclick="showPanel('log',this)">Log</button>
      <button class="nav-tab" onclick="showPanel('analytics',this)">Analytics</button>
      <button class="nav-tab" onclick="showPanel('archive',this)">Archive</button>
      <button class="nav-tab" onclick="showPanel('export',this)">Export</button>
    </nav>

    <!-- LOG PANEL -->
    <div class="panel active" id="panel-log">
      <div style="padding-top:14px;">
        <div class="sec-hdr">
          <span class="sec-title">Trade Log</span>
          <span id="log-count" style="font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);">—</span>
        </div>
        <div class="filter-bar">
          <select class="fsel" id="f-status" onchange="renderLog()">
            <option value="all-active">All Active</option>
            <option value="complete">Complete</option>
            <option value="pending">Pending</option>
            <option value="triggered">Triggered</option>
          </select>
          <select class="fsel" id="f-inst" onchange="renderLog()">
            <option value="">All Instruments</option>
            <option value="EU">EURUSD</option>
            <option value="GU">GBPUSD</option>
            <option value="UC">USDCHF</option>
            <option value="XU">XAUUSD</option>
          </select>
          <select class="fsel" id="f-grade" onchange="renderLog()">
            <option value="">All Grades</option>
            <option value="PRIME">PRIME</option>
            <option value="TAKE">TAKE</option>
            <option value="SKIP">SKIP</option>
          </select>
          <select class="fsel" id="f-outcome" onchange="renderLog()">
            <option value="">All Outcomes</option>
            <option value="Win">Win</option>
            <option value="Loss">Loss</option>
          </select>
        </div>
        <div class="trade-list" id="trade-list">
          <div class="loading">Loading trades...</div>
        </div>
      </div>
    </div>

    <!-- ANALYTICS PANEL -->
    <div class="panel" id="panel-analytics">
      <div style="padding-top:14px;" id="analytics-content">
        <div class="loading">Loading analytics...</div>
      </div>
    </div>

    <!-- ARCHIVE PANEL -->
    <div class="panel" id="panel-archive">
      <div style="padding-top:14px;">
        <div class="sec-hdr">
          <span class="sec-title">Discarded Archive</span>
        </div>
        <div class="trade-list" id="archive-list">
          <div class="loading">Loading archive...</div>
        </div>
      </div>
    </div>

    <!-- EXPORT PANEL -->
    <div class="panel" id="panel-export">
      <div style="padding-top:14px;">
        <div class="sec-hdr"><span class="sec-title">Export</span></div>
        <div class="export-section">
          <div class="export-desc">
            Exports all Complete trade records as a CSV file. Every field is included — all step answers, verdict, outcome, timestamps, and notes. Before and after image URLs are included as links. Pending, Triggered, and Discarded records are excluded.
          </div>
          <button class="export-btn" onclick="doExport()">Export Complete Records as CSV</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ── DETAIL MODAL ── -->
<div class="modal-overlay" id="modal" onclick="closeModalOutside(event)">
  <div class="modal" id="modal-inner">
    <div class="modal-hdr">
      <span class="modal-title" id="modal-title">Trade Record</span>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body" id="modal-body"></div>
  </div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js";
import { getFirestore, collection, addDoc, getDocs, doc, updateDoc, query, orderBy, Timestamp, where } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-storage.js";

const firebaseConfig = {
  apiKey: "AIzaSyD7-KdudvuKAuquuWz94ZYwr6U1b0lBIbk",
  authDomain: "biverway-model-a.firebaseapp.com",
  projectId: "biverway-model-a",
  storageBucket: "biverway-model-a.firebasestorage.app",
  messagingSenderId: "97466390074",
  appId: "1:97466390074:web:fe3e45409b5e35111e8703"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const storage = getStorage(app);

// ── STATE ──────────────────────────────────────────────────────────
let allTrades = [];
let currentTradeId = null;
window._fbUpdate = updateDoc;
window._fbDoc = doc;
window._db = db;
window._storage = storage;
window._storageRef = ref;
window._uploadBytes = uploadBytes;
window._getDownloadURL = getDownloadURL;

// ── AUTH ───────────────────────────────────────────────────────────
onAuthStateChanged(auth, user => {
  if (user) {
    document.getElementById('auth-screen').style.display = 'none';
    document.getElementById('app-screen').style.display = 'block';
    loadTrades();
  } else {
    document.getElementById('auth-screen').style.display = 'flex';
    document.getElementById('app-screen').style.display = 'none';
  }
});

window.doSignIn = async function() {
  const email = document.getElementById('auth-email').value.trim();
  const pass  = document.getElementById('auth-pass').value;
  const errEl = document.getElementById('auth-err');
  errEl.style.display = 'none';
  try {
    await signInWithEmailAndPassword(auth, email, pass);
  } catch(e) {
    errEl.textContent = 'Sign in failed — check credentials.';
    errEl.style.display = 'block';
  }
};

window.doSignOut = async function() {
  await signOut(auth);
};

// Enter key on auth
document.getElementById('auth-pass').addEventListener('keydown', e => {
  if (e.key === 'Enter') window.doSignIn();
});

// ── LOAD TRADES ────────────────────────────────────────────────────
async function loadTrades() {
  try {
    const q = query(collection(db, 'trades'), orderBy('createdAt', 'desc'));
    const snap = await getDocs(q);
    allTrades = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderLog();
    renderArchive();
    renderAnalytics();
  } catch(e) {
    console.error(e);
  }
}

// ── HELPERS ────────────────────────────────────────────────────────
function fmtDate(ts) {
  if (!ts) return '—';
  const d = ts.toDate ? ts.toDate() : new Date(ts);
  return d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
}

function instLabel(i) {
  return {EU:'EURUSD',GU:'GBPUSD',UC:'USDCHF',XU:'XAUUSD'}[i] || i;
}

function stepLabel(key, val) {
  const labels = {
    news: { kill:'Yes — whipsaw', pass:'No — normal day' },
    gap:  { yes:'Gap present', no:'No gap' },
    gpos: { before:'Post-Gap Organic', after:'Gap-Driven Structure' },
    htf:  { pass:'No HTF zone', med:'H4 only', kill:'D1 involved' },
    mssq1:{ yes:'Broker disagree', no:'Brokers agree' },
    mssq2:{ yes:'D1 FVG tap yes', no:'D1 FVG tap no' },
    mssq3:{ yes:'DBI sweep yes', no:'DBI sweep no' },
    zdepth:{ 'deep-h1':'Deep H1','deep-sw':'Deep H1 + Sideways Base','shallow-m45':'Shallow M45','shallow-none':'Shallow No Validation' },
    zliq:  { clean:'Clean',overlap:'Overlapping' },
    asian: { yes:'Coincides with PD Asian range', no:'Independent' },
    dba:   { kill:'Prior failure at DBI Asian range', pass:'No failure' },
    dbh:   { kill:'Prior failure at DBI H/L', pass:'No failure' },
    hist:  { med:'Historical reference level', pass:'Fresh level' },
    loc:   { prime:'PDH/PDL', good:'Near PDH/PDL or 50–79%', mid:'40–50%', weak:'20–40%' },
    candle:{ pos:'Pin Bar / Balanced', neu:'Strong Directional', neg:'Indecisive', med:'DBI Sweep Candle' }
  };
  return (labels[key] && labels[key][val]) || val || '—';
}

// ── RENDER LOG ─────────────────────────────────────────────────────
window.renderLog = function() {
  const statusF  = document.getElementById('f-status').value;
  const instF    = document.getElementById('f-inst').value;
  const gradeF   = document.getElementById('f-grade').value;
  const outcomeF = document.getElementById('f-outcome').value;

  let trades = allTrades.filter(t => t.status !== 'discarded');

  if (statusF === 'complete')   trades = trades.filter(t => t.status === 'complete');
  else if (statusF === 'pending')   trades = trades.filter(t => t.status === 'pending');
  else if (statusF === 'triggered') trades = trades.filter(t => t.status === 'triggered');

  if (instF)    trades = trades.filter(t => t.instrument === instF);
  if (gradeF)   trades = trades.filter(t => t.verdict === gradeF);
  if (outcomeF) trades = trades.filter(t => t.outcome === outcomeF);

  const el = document.getElementById('trade-list');
  document.getElementById('log-count').textContent = trades.length + ' records';

  if (!trades.length) {
    el.innerHTML = '<div class="empty-state">No records match the current filters</div>';
    return;
  }

  el.innerHTML = trades.map(t => tradeCardHTML(t)).join('');
};

function tradeCardHTML(t) {
  const statusClass = t.status === 'complete' ? (t.outcome === 'Win' ? 'win' : 'loss') : t.status;
  const outcomeLabel = t.status === 'complete' ? t.outcome : (t.status === 'pending' ? 'Pending' : 'Triggered');
  const outcomeClass = t.status === 'complete' ? (t.outcome === 'Win' ? 'w' : 'l') : (t.status === 'pending' ? 'p' : 't');
  const flags = (t.flags || []).map(f => `<span class="tc-flag">${f}</span>`).join('');
  return `<div class="trade-card ${statusClass}" onclick="openTrade('${t.id}')">
    <div class="tc-top">
      <span class="tc-inst">${t.instrument || '—'}</span>
      <span class="tc-date">${fmtDate(t.createdAt)}</span>
      <span class="tc-grade ${(t.verdict||'').toLowerCase()}">${t.verdict || '—'}</span>
      <span class="tc-outcome ${outcomeClass}">${outcomeLabel}</span>
    </div>
    ${flags ? `<div class="tc-flags">${flags}</div>` : ''}
  </div>`;
}

// ── RENDER ARCHIVE ─────────────────────────────────────────────────
function renderArchive() {
  const trades = allTrades.filter(t => t.status === 'discarded');
  const el = document.getElementById('archive-list');
  if (!trades.length) {
    el.innerHTML = '<div class="empty-state">No discarded records</div>';
    return;
  }
  el.innerHTML = trades.map(t => tradeCardHTML(t)).join('');
}

// ── OPEN TRADE MODAL ───────────────────────────────────────────────
window.openTrade = function(id) {
  const t = allTrades.find(x => x.id === id);
  if (!t) return;
  currentTradeId = id;

  document.getElementById('modal-title').textContent = `${instLabel(t.instrument)} · ${fmtDate(t.createdAt)}`;

  const steps = [
    ['01 Post News Whipsaw Day', stepLabel('news', t.steps?.news)],
    ['02 Gap Day', stepLabel('gap', t.steps?.gap)],
    ['02 Gap — Zone Type', stepLabel('gpos', t.steps?.gpos)],
    ['03 HTF Opposing Zone', stepLabel('htf', t.steps?.htf)],
    ['04 MSS Q1 Broker', stepLabel('mssq1', t.steps?.mssq1)],
    ['04 MSS Q2 D1 FVG', stepLabel('mssq2', t.steps?.mssq2)],
    ['04 MSS Q3 DBI Sweep', stepLabel('mssq3', t.steps?.mssq3)],
    ['05 Zone Depth', stepLabel('zdepth', t.steps?.zdepth)],
    ['05 Zone Liquidity', stepLabel('zliq', t.steps?.zliq)],
    ['06a Asian Range Coincide', stepLabel('asian', t.steps?.asian)],
    ['06b DBI Asian Range', stepLabel('dba', t.steps?.dba)],
    ['06c DBI High / Low', stepLabel('dbh', t.steps?.dbh)],
    ['06d Historical Reference', stepLabel('hist', t.steps?.hist)],
    ['07 Impulse Ratio', t.steps?.imp || '—'],
    ['08 ADR Ratio', t.steps?.adr || '—'],
    ['09 Zone Location', stepLabel('loc', t.steps?.loc)],
    ['10 PD Candle Type', stepLabel('candle', t.steps?.candle)],
  ].filter(s => s[1] && s[1] !== '—');

  const stepItems = steps.map(s =>
    `<div class="detail-item"><div class="di-label">${s[0]}</div><div class="di-val">${s[1]}</div></div>`
  ).join('');

  const flagItems = (t.flags||[]).map(f =>
    `<span class="tc-flag" style="margin-right:4px;">${f}</span>`
  ).join('') || '<span style="font-family:Space Mono,monospace;font-size:8px;color:var(--dim)">None</span>';

  const killItem = t.killReason ? `<div class="detail-item full"><div class="di-label">Kill Reason</div><div class="di-val" style="color:var(--red)">${t.killReason}</div></div>` : '';

  const beforeImg = t.beforeImage
    ? `<img src="${t.beforeImage}" style="width:100%;height:100%;object-fit:cover;"><span class="img-slot-label">Before</span>`
    : `<span class="img-placeholder">Before image</span>`;
  const afterImg = t.afterImage
    ? `<img src="${t.afterImage}" style="width:100%;height:100%;object-fit:cover;"><span class="img-slot-label">After</span>`
    : `<span class="img-placeholder">No after image</span>`;

  const isComplete = t.status === 'complete';
  const isPending  = t.status === 'pending';
  const isTriggered = t.status === 'triggered';

  let actions = '';
  if (isPending) {
    actions = `
      <div class="action-row">
        <button class="act-btn primary" onclick="markTriggered('${id}')">Mark as Triggered</button>
        <button class="act-btn danger" onclick="markDiscarded('${id}')">Discard Setup</button>
      </div>`;
  } else if (isTriggered) {
    actions = `
      <div style="margin-bottom:10px;">
        <div style="font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;">Record Outcome</div>
        <div style="display:flex;gap:8px;margin-bottom:10px;">
          <button class="act-btn primary" onclick="markComplete('${id}','Win')">Win</button>
          <button class="act-btn danger" onclick="markComplete('${id}','Loss')">Loss</button>
        </div>
        <div style="font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:6px;">After Chart Image</div>
        <div class="upload-zone" onclick="document.getElementById('after-upload-${id}').click()">
          <input type="file" id="after-upload-${id}" accept="image/*" onchange="previewAfter(this,'${id}')">
          <div class="upload-zone-txt">Tap to attach after chart</div>
          <img id="after-preview-${id}" class="upload-preview">
        </div>
        <div style="font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);letter-spacing:0.08em;text-transform:uppercase;margin:10px 0 6px;">Notes</div>
        <textarea class="modal-notes" id="notes-${id}" placeholder="Optional trade notes...">${t.notes||''}</textarea>
      </div>`;
  }

  if (isComplete) {
    actions = `
      <div>
        <div style="font-family:'Space Mono',monospace;font-size:8px;color:var(--dim);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:6px;">Notes</div>
        <textarea class="modal-notes" id="notes-${id}" placeholder="Optional notes...">${t.notes||''}</textarea>
        <button class="act-btn" style="margin-top:8px;" onclick="saveNotes('${id}')">Save Notes</button>
      </div>`;
  }

  document.getElementById('modal-body').innerHTML = `
    <div class="modal-section">
      <div class="modal-sec-title">Summary</div>
      <div class="detail-grid">
        <div class="detail-item"><div class="di-label">Instrument</div><div class="di-val">${instLabel(t.instrument)}</div></div>
        <div class="detail-item"><div class="di-label">Date</div><div class="di-val">${fmtDate(t.createdAt)}</div></div>
        <div class="detail-item"><div class="di-label">Verdict</div><div class="di-val" style="color:${t.verdict==='PRIME'?'var(--gold)':t.verdict==='TAKE'?'var(--green)':'var(--red)'}">${t.verdict||'—'}</div></div>
        <div class="detail-item"><div class="di-label">Outcome</div><div class="di-val" style="color:${t.outcome==='Win'?'var(--green)':t.outcome==='Loss'?'var(--red)':'var(--dim)'}">${t.outcome||t.status||'—'}</div></div>
        <div class="detail-item full"><div class="di-label">Active Flags</div><div class="di-val" style="margin-top:3px;">${flagItems}</div></div>
        ${killItem}
      </div>
    </div>
    <div class="modal-section">
      <div class="modal-sec-title">Step Answers</div>
      <div class="detail-grid">${stepItems}</div>
    </div>
    <div class="modal-section">
      <div class="modal-sec-title">Charts</div>
      <div class="img-pair">
        <div class="img-slot">${beforeImg}</div>
        <div class="img-slot">${afterImg}</div>
      </div>
    </div>
    ${actions ? `<div class="modal-section">${actions}</div>` : ''}
  `;

  document.getElementById('modal').classList.add('open');
};

window.closeModal = function() {
  document.getElementById('modal').classList.remove('open');
  currentTradeId = null;
};
window.closeModalOutside = function(e) {
  if (e.target === document.getElementById('modal')) window.closeModal();
};

// ── STATUS TRANSITIONS ─────────────────────────────────────────────
window.markTriggered = async function(id) {
  await updateDoc(doc(db, 'trades', id), { status:'triggered', triggeredAt: Timestamp.now() });
  allTrades = allTrades.map(t => t.id===id ? {...t, status:'triggered', triggeredAt:Timestamp.now()} : t);
  window.closeModal();
  renderLog(); renderAnalytics();
};

window.markDiscarded = async function(id) {
  if (!confirm('Discard this setup? It will be moved to the archive and excluded from all analytics.')) return;
  await updateDoc(doc(db, 'trades', id), { status:'discarded' });
  allTrades = allTrades.map(t => t.id===id ? {...t, status:'discarded'} : t);
  window.closeModal();
  renderLog(); renderArchive(); renderAnalytics();
};

window.previewAfter = function(input, id) {
  const file = input.files[0];
  if (!file) return;
  const preview = document.getElementById(`after-preview-${id}`);
  preview.src = URL.createObjectURL(file);
  preview.style.display = 'block';
};

window.markComplete = async function(id, outcome) {
  const notesEl = document.getElementById(`notes-${id}`);
  const notes = notesEl ? notesEl.value : '';
  const afterInput = document.getElementById(`after-upload-${id}`);
  let afterUrl = null;

  if (afterInput && afterInput.files[0]) {
    const file = afterInput.files[0];
    const sRef = ref(storage, `trades/${id}/after_${Date.now()}`);
    const snap = await uploadBytes(sRef, file);
    afterUrl = await getDownloadURL(snap.ref);
  }

  const update = {
    status:'complete',
    outcome,
    completedAt: Timestamp.now(),
    notes,
    ...(afterUrl && { afterImage: afterUrl })
  };

  await updateDoc(doc(db, 'trades', id), update);
  allTrades = allTrades.map(t => t.id===id ? {...t, ...update} : t);
  window.closeModal();
  renderLog(); renderAnalytics();
};

window.saveNotes = async function(id) {
  const notesEl = document.getElementById(`notes-${id}`);
  if (!notesEl) return;
  await updateDoc(doc(db, 'trades', id), { notes: notesEl.value });
  allTrades = allTrades.map(t => t.id===id ? {...t, notes:notesEl.value} : t);
};

// ── ANALYTICS ─────────────────────────────────────────────────────
function renderAnalytics() {
  const complete = allTrades.filter(t => t.status === 'complete');
  const el = document.getElementById('analytics-content');

  if (!complete.length) {
    el.innerHTML = '<div class="empty-state" style="padding-top:40px;">No complete records yet. Analytics will appear as trades are completed.</div>';
    return;
  }

  function stats(trades) {
    const w = trades.filter(t=>t.outcome==='Win').length;
    const l = trades.filter(t=>t.outcome==='Loss').length;
    const wr = trades.length ? Math.round(w/trades.length*100) : 0;
    const rrr = w*3 - l;
    let ms=0,cs=0;
    trades.forEach(t=>{ if(t.outcome==='Loss'){cs++;ms=Math.max(ms,cs);}else cs=0; });
    return {w,l,n:trades.length,wr,rrr,ms};
  }

  const all  = stats(complete);
  const prime = stats(complete.filter(t=>t.verdict==='PRIME'));
  const take  = stats(complete.filter(t=>t.verdict==='TAKE'));

  // Aggregate cards
  const aggHTML = `
    <div class="an-sec">
      <div class="an-sec-title">Aggregate Performance · ${complete.length} complete records</div>
      <div class="analytics-grid">
        <div class="stat-card">
          <div class="stat-eye">Win Rate</div>
          <div class="stat-val" style="color:${all.wr>=70?'var(--green)':all.wr>=50?'var(--amber)':'var(--red)'}">${all.wr}%</div>
          <div class="stat-sub">${all.w}W / ${all.l}L</div>
        </div>
        <div class="stat-card">
          <div class="stat-eye">Net RRR at 1:3</div>
          <div class="stat-val" style="color:${all.rrr>0?'var(--gold)':'var(--red)'}">${all.rrr>0?'+':''}${all.rrr}R</div>
          <div class="stat-sub">${complete.length} trades</div>
        </div>
        <div class="stat-card">
          <div class="stat-eye">PRIME</div>
          <div class="stat-val" style="color:var(--gold)">${prime.n ? prime.wr+'%' : '—'}</div>
          <div class="stat-sub">${prime.n} trades · ${prime.w}W / ${prime.l}L</div>
        </div>
        <div class="stat-card">
          <div class="stat-eye">TAKE</div>
          <div class="stat-val" style="color:var(--green)">${take.n ? take.wr+'%' : '—'}</div>
          <div class="stat-sub">${take.n} trades · ${take.w}W / ${take.l}L</div>
        </div>
        <div class="stat-card">
          <div class="stat-eye">Max Losing Streak</div>
          <div class="stat-val" style="color:var(--text3)">${all.ms}</div>
          <div class="stat-sub">Complete records</div>
        </div>
        <div class="stat-card">
          <div class="stat-eye">Instruments</div>
          <div class="stat-val" style="font-size:14px;color:var(--text3)">${['EU','GU','UC','XU'].map(i=>{const n=complete.filter(t=>t.instrument===i).length; return n?`${i}:${n}`:''}).filter(Boolean).join(' · ')}</div>
          <div class="stat-sub">By instrument count</div>
        </div>
      </div>
    </div>`;

  // Per-instrument breakdown
  const instRows = ['EU','GU','UC','XU'].map(i => {
    const ts = complete.filter(t=>t.instrument===i);
    if (!ts.length) return '';
    const s = stats(ts);
    return `<tr><td>${instLabel(i)}</td><td class="val-neu">${s.n}</td><td class="${s.wr>=65?'val-pos':s.wr>=50?'val-neu':'val-neg'}">${s.wr}%</td><td class="${s.rrr>0?'val-gld':'val-neg'}">${s.rrr>0?'+':''}${s.rrr}R</td><td class="val-neu">${s.ms}</td></tr>`;
  }).join('');

  const instHTML = instRows ? `
    <div class="an-sec">
      <div class="an-sec-title">By Instrument</div>
      <div style="background:var(--surf2);border:1px solid var(--line);border-radius:9px;overflow:hidden;">
        <table class="breakdown-table">
          <tr><th>Instrument</th><th>Trades</th><th>Win Rate</th><th>RRR</th><th>Max Streak</th></tr>
          ${instRows}
        </table>
      </div>
    </div>` : '';

  // Filter performance breakdown
  const filterDefs = [
    { label:'HTF Opposing Zone', key:'htf', opts:[{v:'pass',l:'No HTF'},{v:'med',l:'H4 Only'},{v:'kill',l:'D1 Involved'}] },
    { label:'MSS Q1 Broker', key:'mssq1', opts:[{v:'yes',l:'Disagree'},{v:'no',l:'Agree'}] },
    { label:'MSS Q2 D1 FVG', key:'mssq2', opts:[{v:'yes',l:'FVG Yes'},{v:'no',l:'FVG No'}] },
    { label:'Zone Depth', key:'zdepth', opts:[{v:'deep-h1',l:'Deep H1'},{v:'deep-sw',l:'Deep + Sideways'},{v:'shallow-m45',l:'Shallow M45'},{v:'shallow-none',l:'Shallow None'}] },
    { label:'Zone Liquidity', key:'zliq', opts:[{v:'clean',l:'Clean'},{v:'overlap',l:'Overlap'}] },
    { label:'Historical Ref', key:'hist', opts:[{v:'med',l:'Historical Ref'},{v:'pass',l:'Fresh Level'}] },
    { label:'PD Candle Type', key:'candle', opts:[{v:'pos',l:'Pin Bar/Balanced'},{v:'neu',l:'Strong Directional'},{v:'neg',l:'Indecisive'},{v:'med',l:'DBI Sweep'}] },
    { label:'Zone Location', key:'loc', opts:[{v:'prime',l:'PDH/PDL'},{v:'good',l:'Near PDH or 50-79%'},{v:'mid',l:'40-50%'},{v:'weak',l:'20-40%'}] },
  ];

  const filterRows = filterDefs.map(fd => {
    const rows = fd.opts.map(opt => {
      const ts = complete.filter(t => t.steps && t.steps[fd.key] === opt.v);
      if (!ts.length) return '';
      const s = stats(ts);
      return `<tr><td>${fd.label}</td><td>${opt.l}</td><td class="val-neu">${s.n}</td><td class="${s.wr>=65?'val-pos':s.wr>=50?'val-neu':'val-neg'}">${s.wr}%</td><td class="${s.rrr>0?'val-gld':'val-neg'}">${s.rrr>0?'+':''}${s.rrr}R</td></tr>`;
    }).join('');
    return rows;
  }).join('');

  const filterHTML = filterRows ? `
    <div class="an-sec">
      <div class="an-sec-title">Filter Performance Breakdown</div>
      <div style="background:var(--surf2);border:1px solid var(--line);border-radius:9px;overflow:hidden;">
        <table class="breakdown-table">
          <tr><th>Filter</th><th>Answer</th><th>Trades</th><th>Win Rate</th><th>RRR</th></tr>
          ${filterRows}
        </table>
      </div>
    </div>` : '';

  // Pattern alerts
  const alerts = [];
  const MIN_SAMPLE = 10;
  const DEVIATION = 15;
  const overallWR = all.wr;

  filterDefs.forEach(fd => {
    fd.opts.forEach(opt => {
      const ts = complete.filter(t => t.steps && t.steps[fd.key] === opt.v);
      if (ts.length < MIN_SAMPLE) return;
      const s = stats(ts);
      if (s.wr < overallWR - DEVIATION) {
        alerts.push({ title:`${fd.label} — ${opt.l}`, body:`Win rate ${s.wr}% across ${s.n} trades. Overall filtered rate is ${overallWR}%. ${DEVIATION}pt+ below average. Review whether this condition warrants reclassification.`, n:s.n });
      }
    });
  });

  // Instrument alerts
  ['EU','GU','UC','XU'].forEach(i => {
    const ts = complete.filter(t=>t.instrument===i);
    if (ts.length < MIN_SAMPLE) return;
    const s = stats(ts);
    if (s.wr < overallWR - DEVIATION) {
      alerts.push({ title:`${instLabel(i)} — Underperforming`, body:`Win rate ${s.wr}% across ${s.n} trades. ${DEVIATION}pt+ below system average of ${overallWR}%. Consider instrument-specific review.`, n:s.n });
    }
  });

  const alertsHTML = alerts.length ? `
    <div class="an-sec">
      <div class="an-sec-title">Pattern Alerts · Min ${MIN_SAMPLE} trades · ${DEVIATION}pt deviation threshold</div>
      ${alerts.map(a=>`
        <div class="alert-card">
          <div class="alert-title">${a.title}</div>
          <div class="alert-body">${a.body}</div>
          <div class="sample-note">Sample: ${a.n} trades</div>
        </div>`).join('')}
    </div>` : `
    <div class="an-sec">
      <div class="an-sec-title">Pattern Alerts</div>
      <div class="empty-state" style="padding:20px 0;text-align:left;">No patterns flagged — no condition combination has reached ${MIN_SAMPLE} trades with ${DEVIATION}pt+ deviation from overall win rate.</div>
    </div>`;

  el.innerHTML = aggHTML + instHTML + filterHTML + alertsHTML;
}

// ── EXPORT ─────────────────────────────────────────────────────────
window.doExport = function() {
  const complete = allTrades.filter(t => t.status === 'complete');
  if (!complete.length) { alert('No complete records to export.'); return; }

  const headers = ['id','instrument','date','verdict','outcome','killReason','flags','imp','adr',
    'news','gap','gpos','htf','mssq1','mssq2','mssq3','zdepth','zliq','asian','dba','dbh','hist','loc','candle',
    'beforeImage','afterImage','notes','createdAt','triggeredAt','completedAt'];

  const rows = complete.map(t => headers.map(h => {
    if (h === 'date') return fmtDate(t.createdAt);
    if (h === 'flags') return (t.flags||[]).join('; ');
    if (h === 'imp') return t.steps?.imp || '';
    if (h === 'adr') return t.steps?.adr || '';
    if (['news','gap','gpos','htf','mssq1','mssq2','mssq3','zdepth','zliq','asian','dba','dbh','hist','loc','candle'].includes(h))
      return t.steps?.[h] || '';
    if (['createdAt','triggeredAt','completedAt'].includes(h))
      return t[h] ? fmtDate(t[h]) : '';
    return (t[h] ?? '').toString().replace(/,/g,'|');
  }));

  const csv = [headers, ...rows].map(r => r.map(v => `"${v}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type:'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `biverway-trades-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
};

// ── NAV ────────────────────────────────────────────────────────────
window.showPanel = function(name, btn) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById(`panel-${name}`).classList.add('active');
  btn.classList.add('active');
};

// ── EXPOSE SAVE FUNCTION FOR DECISION ENGINE ───────────────────────
window._saveTradeRecord = async function(tradeData) {
  try {
    const docRef = await addDoc(collection(db, 'trades'), {
      ...tradeData,
      createdAt: Timestamp.now(),
      status: 'pending'
    });
    return docRef.id;
  } catch(e) {
    console.error('Save failed:', e);
    return null;
  }
};

